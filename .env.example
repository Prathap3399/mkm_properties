# ==============================================================================
# MKM Properties – Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Cryptographic JWT Session Secret
# Generate in terminal using: openssl rand -hex 32
ADMIN_JWT_SECRET=dev_jwt_secret_change_me_to_random_string_32_characters_minimum

# 3. Optional Admin Bootstrapping
# Or use: npm run admin:create
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PHONE=

# 4. Email Notifications (Resend)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=

# 5. Meta Ads Tracking (Pixel & Conversions API)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# 6. Database
# Local development uses SQLite at ./data/mkm_properties.db (WAL mode)
# When deploying to Cloudflare Workers, Cloudflare D1 is bound via wrangler.jsonc
