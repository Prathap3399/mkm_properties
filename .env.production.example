# ==============================================================================
# MKM Properties - Production Environment Configuration
# Copy this file to .env.production on your production server.
# NEVER commit .env.production to version control.
# ==============================================================================

# 1. Production Application URL (FQDN with HTTPS)
NEXT_PUBLIC_APP_URL=https://mkmproperties.com

# 2. Cryptographic JWT Session Secret
# Generate a secure 64-character hex secret using:
#   openssl rand -hex 32
# MUST be unique and kept confidential.
ADMIN_JWT_SECRET=

# 3. Initial Administrator Provisioning (Optional bootstrap)
# If provided, an admin will be provisioned on first launch if none exists.
# Alternatively, leave blank and run: npm run admin:create
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PHONE=

# 4. Email Notifications (Resend API)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=advisor@mkmproperties.com
EMAIL_FROM=MKM Properties <notifications@mkmproperties.com>

# 5. Meta Advertising / Conversion Tracking (Optional)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# 6. Runtime Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_OUTPUT_STANDALONE=true

